# Gemini Live API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default 3000)
PORT=3000

# Live Voice Model Identifier
# - gemini-3.1-flash-live-preview (default, lowest latency: ~1s to first audio)
# - gemini-2.5-flash-native-audio-preview-12-2025 (works, but 3-5s to first audio)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Preferred Voice Tone (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_LIVE_VOICE=Aoede
