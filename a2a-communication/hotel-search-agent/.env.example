# Local development configuration.
# For VM deployment, these are set via the systemd unit / shell env on the box.

# Which port the Express server listens on.
PORT=8080

# Externally reachable base URL for this agent - baked into the AgentCard's
# supportedInterfaces[].url so other agents know where to send requests.
# For local dev this can stay as-is; for the Compute Engine VM, set it to
# http://<external-ip>:8080.
APP_URL=http://localhost:8080

# Vertex AI (Gemini) configuration - ADC must already be configured
# (gcloud auth application-default login) or GOOGLE_APPLICATION_CREDENTIALS set.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MODEL_NAME=gemini-3.7-flash

AGENT_VERSION=0.1.0
