# ============================================================================
# VibeStudio — Agentic Workflow with Google ADK (.env configuration)
# ============================================================================

# Dual-Mode Execution:
#   mock -> Fast local simulation for RAG, Memory Bank, Imagen 3 & Veo (works with just a free Gemini API key)
#   live -> Uses live Vertex AI RAG Engine, Imagen 3, Google Veo, and GCS bucket on GCP
WORKSHOP_MODE=mock

# Model override (default: gemini-2.5-flash)
VIBESTUDIO_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# Option A: Gemini Developer API Key (Simplest for local / Cloud Shell runs)
# ----------------------------------------------------------------------------
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ----------------------------------------------------------------------------
# Option B: Vertex AI (Required when WORKSHOP_MODE=live for Veo & Vertex RAG)
# ----------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# VIBESTUDIO_GCS_BUCKET=gs://YOUR_PROJECT_ID-vibestudio-media
# VERTEX_RAG_CORPUS_NAME=projects/YOUR_PROJECT_ID/locations/us-central1/ragCorpora/YOUR_CORPUS_ID
